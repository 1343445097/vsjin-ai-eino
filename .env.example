VSJIN_AI_DATA_DIR=./data
VSJIN_AI_API_TOKEN=
VSJIN_MODEL_PROVIDER=openai
VSJIN_MODEL_NAME=
VSJIN_MODEL_API_KEY=
VSJIN_MODEL_BASE_URL=
VSJIN_MESSAGE_KIND=message
